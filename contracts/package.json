{
  "name": "@takarail/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "TakaRail settlement contracts",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "chain": "hardhat node --port 8645",
    "deploy:local": "hardhat run scripts/deploy.ts --network local",
    "spec": "hardhat compile --quiet && mocha",
    "typecheck": "tsc --noEmit",
    "build": "hardhat compile && hardhat run scripts/export-abi.ts",
    "export-abi": "hardhat run scripts/export-abi.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.0",
    "chai": "^4.5.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "mocha": "^10.8.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
