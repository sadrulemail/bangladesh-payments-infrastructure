# Copy of the settings the stack reads. Run `pnpm setup` to create .env with generated secrets.

# --- chain -------------------------------------------------------------------------------------
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8645
# The local node starts its clock this many days in the past, so a week of activity can be replayed.
CHAIN_START_DAYS_AGO=7
# Fee per unit of gas in wei. The network is permissioned and charges no gas.
GAS_PRICE_WEI=0
# BIP-39 mnemonic of the custody keystore. Every operator and custodial wallet is derived from it.
CUSTODY_MNEMONIC=

# --- database ----------------------------------------------------------------------------------
POSTGRES_PORT=5544
POSTGRES_PASSWORD=
DATABASE_URL=

# --- API ---------------------------------------------------------------------------------------
API_PORT=4100
CONSOLE_ORIGIN=http://localhost:5180
# At least 32 characters.
JWT_SECRET=
# Passphrase given to the operators created by the seed script. At least 12 characters.
OPERATOR_PASSPHRASE=
# "enabled" lets the sign-in page list operator profiles. Use "disabled" outside a private environment.
OPERATOR_DIRECTORY=enabled
